# ========== KOTAK NEO API CREDENTIALS ==========
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_SESSION_TOKEN=your_session_token_here
KOTAK_SID=your_sid_here
KOTAK_SERVER_ID=your_server_id_here
KOTAK_ENVIRONMENT=uat

# ========== MASTER TRADER CONFIGURATION ==========
# Fill these with the source / master account that will generate signals.
MASTER_TRADER_ID=master_trader_id
MASTER_TRADER_API_KEY=master_api_key

# ========== CHILD / FOLLOWER ACCOUNT CONFIGURATION ==========
# Fill these with each follower account that should copy the master trades.
# Add one block per child account you want to support.
FOLLOWER_ACCOUNT_1_NAME=child_account_1
FOLLOWER_ACCOUNT_1_KOTAK_CONSUMER_KEY=your_child_consumer_key_here
FOLLOWER_ACCOUNT_1_KOTAK_CONSUMER_SECRET=your_child_consumer_secret_here
FOLLOWER_ACCOUNT_1_KOTAK_SESSION_TOKEN=your_child_session_token_here
FOLLOWER_ACCOUNT_1_KOTAK_SID=your_child_sid_here
FOLLOWER_ACCOUNT_1_KOTAK_SERVER_ID=your_child_server_id_here

FOLLOWER_ACCOUNT_2_NAME=child_account_2
FOLLOWER_ACCOUNT_2_KOTAK_CONSUMER_KEY=your_child_consumer_key_here
FOLLOWER_ACCOUNT_2_KOTAK_CONSUMER_SECRET=your_child_consumer_secret_here
FOLLOWER_ACCOUNT_2_KOTAK_SESSION_TOKEN=your_child_session_token_here
FOLLOWER_ACCOUNT_2_KOTAK_SID=your_child_sid_here
FOLLOWER_ACCOUNT_2_KOTAK_SERVER_ID=your_child_server_id_here

# ========== RISK MANAGEMENT ==========
MAX_DRAWDOWN_PERCENT=10
DAILY_LOSS_LIMIT=50000
MAX_CONCURRENT_POSITIONS=5
MAX_POSITION_SIZE=100000

# ========== DATABASE ==========
DATABASE_URL=sqlite:///data/trading.db

# ========== LOGGING ==========
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# ========== API SERVER ==========
API_PORT=8080
API_HOST=0.0.0.0
DEBUG=false
